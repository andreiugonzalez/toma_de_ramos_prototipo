# === Firebase (Web) ===
# 1) Copia este archivo con el nombre ".env" en la raíz del proyecto.
# 2) Pega los valores que te entrega Firebase:
#    Configuración del proyecto > Tus apps > (app web) > SDK setup and configuration > Config
# 3) Reinicia el servidor (npm run dev) para que Vite lea las variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
